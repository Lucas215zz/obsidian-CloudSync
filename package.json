{
  "name": "obsidian-cos-sync",
  "version": "1.1.0",
  "description": "Sync your Obsidian vault to Tencent Cloud Object Storage (COS) with real-time and scheduled sync, plus conflict-safe multi-device support.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "cos",
    "tencent",
    "sync"
  ],
  "author": "Lusixian",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0"
  }
}
